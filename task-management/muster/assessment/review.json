  "lifecycle_review": {
    "create": "Project/board bootstrap and WIP-checked card/association/rank/event write under a scoped transaction",
    "select": "Board/list reads and role-classified lanes; no authoritative claim-next dispatcher or dependency cycle validation",
    "claim": "Transactional card lock/check/write with one current claimed_by and durable assignee; claim and active-lane move are separate requests",
    "progress": "Attributed mutable comments, linked document versions, knowledge and external work references; no typed attempt/checkpoint",
    "review": "Cards use optional review lane and agent instructions; documents separately enforce role/version-checked forward approval and approved-content immutability",
    "complete": "Permitted lane move records completed event when entering terminal; no task acceptance gate, current-lease check or claim cleanup",
    "cancel": "Archive visibility or destructive delete; no distinct cancelled/failed/interrupted attempt outcome",
    "recover": "Agent heartbeat renews all its claims, minute sweeper clears expired lease fields with an event, offboarding revokes credentials; assignees/lane persist and stale sessions are not fenced"
  },
