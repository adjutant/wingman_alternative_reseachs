  "lifecycle_review": {
    "create": "Allocator lock, occupied identity scan including sibling worktrees, parent/dependency validation, exclusive filename write, separate Git finalization with ownership-aware rollback",
    "select": "Shared full-corpus readiness and graph projection; unresolved/ambiguous dependencies fail closed; configured final status defines completion",
    "claim": "No execution claim; editable assignee lists and short mutation locks do not reserve worker ownership",
    "progress": "Canonical patch rereads under per-task lock; notes, checklists, comments and summary are mutable task content; board bulk writes instead use pre-lock full snapshots",
    "review": "Structured AC and DoD records without independent reviewer identity, evidence revision binding or enforced acceptance gate",
    "complete": "Canonical status edit or public board move; no readiness, children, checklist or review gate in these paths; post-save callback does not veto transition",
    "cancel": "Any-status archive and restore preserve record identity/status; archived-only deletion refuses children, rewrites references and may release ID; no worker process cancellation",
    "recover": "Durable files, stale edit-lock handling and moved/deleted-but-not-committed errors aid manual recovery; no attempt lease/fencing/resume protocol; multi-file and Git stages are not one transaction"
  },
